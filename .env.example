# Copy to .env.local and fill in. Never commit real values.
# On Render these go in the service's Environment tab. See docs/GO-LIVE.md.

# Postgres connection. Local value matches docker-compose.yml.
DATABASE_URL=postgres://sash:sash_dev@127.0.0.1:5433/sash

# Signs sessions and tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the site, used in email links. https is required in production.
BETTER_AUTH_URL=http://localhost:3000

# Who can open /admin. Comma separated. Each person signs up normally first.
ADMIN_EMAILS=admin@example.org

# Required in production. Sender must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Required in production. Without them, development uses a fake payment gateway
# that always succeeds.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Required in production. Sent by the GitHub Action that runs the daily job.
CRON_SECRET=

# Development only. Without Resend, emails are logged and appended to this file.
DEV_MAIL_FILE=.dev-mail.jsonl
