# Copy to .env.local and fill in. Never commit real values.

# Postgres connection. Local value matches docker-compose.yml.
DATABASE_URL=postgres://sash:sash_dev@127.0.0.1:5433/sash

# Signs sessions and tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the site, used in email links.
BETTER_AUTH_URL=http://localhost:3000

# Required in production. Sender must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Development only. Without Resend, emails are logged and appended to this file.
DEV_MAIL_FILE=.dev-mail.jsonl
